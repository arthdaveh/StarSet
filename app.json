{
  "expo": {
    "scheme": "starset",
    "name": "StarSet",
    "slug": "StarSet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios-tinted.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#151718"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arth.StarSet",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.StarSet"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c44a401-bd8c-4971-88c7-74d005e8c4cb"
      }
    }
  }
}
